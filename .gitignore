# MatRisk AI - Production .gitignore
# Optimized for Streamlit, ML, and Windows development

### Python ###
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.deprecated
.pytest_cache/
.hypothesis/
.terrace/

### Virtual Environments ###
# Ignore local environment folders
venv/
.venv/
env/
ENV/
bin/
include/
Lib/
Scripts/
pyvenv.cfg

### Streamlit ###
# Ignore secrets and local config overrides
.streamlit/secrets.toml

### Environment Variables ###
# Ignore sensitive credentials
.env
.env.local
*.env

### Operating System ###
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

### Databases ###
# Ignore SQLite and other local database files
*.db
*.sqlite
*.sqlite3

### IDEs ###
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, etc.)
.idea/

### Jupyter Notebooks ###
.ipynb_checkpoints
*/.ipynb_checkpoints/*

### Project Specific Exports ###
# Ignore generated reports and exports
reports/generated/
*.pdf
*.xlsx
*.csv_export
# Do NOT ignore the source datasets
!datasets/processed/*.csv

### Logs and Temp ###
*.log
tmp/
temp/
*.tmp
*.bak
*.swp
